{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "musely-preview",
  "account_id": "d0d06bd043ebf75c9fd8aba7c458243a",
  "compatibility_date": "2026-10-31",
  "main": "worker/index.ts",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{"name": "WORLD", "class_name": "WorldDO"}]
  },
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["WorldDO"]}],
  "ratelimits": [{"name": "BURST", "namespace_id": "26110101", "simple": {"limit": 20, "period": 60}}],
  "vars": {
    "MODEL_ID": "muse-spark-1.3",
    "MODEL_BASE": "https://api.meta.ai/v1",
    "DAILY_BUDGET_USD": "20",
    "TURNSTILE_SITEKEY": "0x4AAAAAAFu3dgEV5S3LzeDU",
    "ALLOWED_HOSTS": "preview.musely.net"
  },
  "observability": {"enabled": true},
  "routes": [
    {
      "pattern": "preview.musely.net",
      "custom_domain": true
    }
  ]
}
