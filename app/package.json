{
  "name": "musely",
  "private": true,
  "version": "0.13.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test scripts/*.test.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "npm test && npm run typecheck && npm run build && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "pretypecheck": "node scripts/prepare-assets.mjs",
    "proof:build": "node scripts/build-character-proof.mjs",
    "proof:dev": "python3 -m http.server 8788 --bind 127.0.0.1 --directory dist-character-proof"
  },
  "dependencies": {
    "maplibre-gl": "6.16.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "wrangler": "4.154.0"
  }
}
