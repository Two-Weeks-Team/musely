{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "musely",
  "account_id": "d0d06bd043ebf75c9fd8aba7c458243a",
  "compatibility_date": "2026-10-31",
  "main": "worker/index.ts",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [{"name": "WORLD", "class_name": "WorldDO"}]
  },
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["WorldDO"]}],
  "ratelimits": [{"name": "BURST", "namespace_id": "26110201", "simple": {"limit": 20, "period": 60}}],
  "vars": {
    "WORLD_LIFE_MODE": "sandbox-v1",
    "SOCIAL_STATUS_MODE": "public-v1",
    "RESIDENT_VALUES_MODE": "confirmed-v1",
    "RESIDENT_REFLECTION_MODE": "private-v1",
    "RESIDENT_ACTIONS_MODE": "action-v1",
    "RESIDENT_ACTION_MAX_CONCURRENT": "4",
    "MODEL_ID": "muse-spark-1.3",
    "MODEL_BASE": "https://api.meta.ai/v1",
    "DAILY_BUDGET_USD": "30",
    "RESIDENT_BUDGET_MODE": "split-v1",
    "RESIDENT_MODEL_ENABLED": "true",
    "RESIDENT_DAILY_BUDGET_USD": "24",
    "INTERACTIVE_DAILY_BUDGET_USD": "6",
    "RESIDENT_HOURLY_BUDGET_USD": "1",
    "MODEL_PERIOD_BUDGET_USD": "150",
    "MODEL_BUDGET_START_AT": "2026-11-04T00:00:00+09:00",
    "MODEL_BUDGET_END_AT": "2026-11-09T00:00:00+09:00",
    "TURNSTILE_SITEKEY": "0x4AAAAAAFu3dgEV5S3LzeDU",
    "ALLOWED_HOSTS": "musely.net,www.musely.net",
    "PUBLIC_ORIGIN": "https://musely.net"
  },
  "observability": {"enabled": true},
  "routes": [
    {"pattern": "musely.net", "custom_domain": true},
    {"pattern": "www.musely.net", "custom_domain": true}
  ]
}
